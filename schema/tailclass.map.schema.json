{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/Infinitode/TailClass/main/schema/tailclass.map.schema.json",
  "title": "TailClass Mapping Dictionary",
  "description": "Editable Class List Mode dictionary generated by `tailclass list`.",
  "type": "object",
  "required": ["mappings"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string" },
    "generatedAt": { "type": "string" },
    "instructions": { "type": "string" },
    "summary": {
      "type": "object",
      "properties": {
        "filesScanned": { "type": "integer" },
        "filesWithClasses": { "type": "integer" },
        "totalClassAttributes": { "type": "integer" },
        "totalUtilityTokens": { "type": "integer" },
        "uniqueUtilityTokens": { "type": "integer" },
        "uniqueClassPatterns": { "type": "integer" },
        "extractablePatterns": { "type": "integer" },
        "totalReplacementsPossible": { "type": "integer" }
      }
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["classes"],
        "properties": {
          "id": { "type": "string" },
          "autoName": { "type": "string" },
          "customName": {
            "type": "string",
            "description": "Type your preferred CSS class name here to override autoName."
          },
          "enabled": {
            "type": "boolean",
            "default": true,
            "description": "Set to false to skip extracting this pattern."
          },
          "category": { "type": "string" },
          "label": { "type": "string" },
          "confidence": { "type": "number" },
          "matchType": { "type": "string" },
          "classCount": { "type": "integer" },
          "classes": { "type": "string" },
          "timesFound": { "type": "integer" },
          "exactMatches": { "type": "integer" },
          "subsetMatches": { "type": "integer" },
          "fileCount": { "type": "integer" },
          "elements": { "type": "array", "items": { "type": "string" } },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file": { "type": "string" },
                "count": { "type": "integer" },
                "lines": { "type": "array", "items": { "type": "integer" } }
              }
            }
          }
        }
      }
    },
    "utilityInventory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "utility": { "type": "string" },
          "timesFound": { "type": "integer" },
          "fileCount": { "type": "integer" },
          "files": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
